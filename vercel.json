{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ledger",
      "destination": "/records",
      "permanent": true
    },
    {
      "source": "/e/ev-009",
      "destination": "/e/ev-098",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|geo/|.*\\..*).*)",
      "destination": "/spa"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/snapshot/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
